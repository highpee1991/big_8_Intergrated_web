// prisma/schema.prisma
//
// Big 8 Integrated , data model
//
// Structure: Division -> Category (optional) -> Product -> ProductImage
// e.g. Oil & Gas Equipment -> Valves -> "2-inch Gate Valve" -> photos
//
// Notes:
// - `images` on Product is a relation (ProductImage[]), not image1/image2/image3
//   columns , a product can have 1 photo or 30 without ever touching this file again.
// - `price` is optional. When null, the UI shows "Contact us for pricing".
// - `specs` is a Json field (flexible key/value technical specs) , different
//   product categories (a valve vs. a forklift) can have completely different
//   spec sheets without needing a fixed set of columns.
// - `category` is optional on Product , divisions that don't have a nav
//   sub-menu yet (e.g. Medical) can leave products uncategorized until they do.
// - Division doubles as your existing "Industries" concept , same data as
//   src/data/industries.ts, now backed by the DB.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Division {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String
  icon        String // lucide-react icon name, e.g. "Fuel", "Truck"
  categories  Category[]
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("divisions")
}

// Sub-menu items under a division in the Products nav, e.g. Oil & Gas ->
// Valves / Actuators / Welding Material. Optional on Product , not every
// division needs this layer yet.
model Category {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  division   Division  @relation(fields: [divisionId], references: [id])
  divisionId String
  products   Product[]
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())

  @@map("categories")
  @@index([divisionId])
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  logoUrl   String
  website   String?
  products  Product[]
  createdAt DateTime  @default(now())

  @@map("brands")
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique // -> /products/lg-17500-diesel-forklift
  title       String
  summary     String
  description String?  @db.Text

  price    Decimal? @db.Decimal(10, 2) // null = "Contact us for pricing"
  currency String   @default("USD")

  specs Json? // flexible key/value technical specs

  featured Boolean @default(false)
  isActive Boolean @default(true) // soft "unpublish" without deleting

  division   Division @relation(fields: [divisionId], references: [id])
  divisionId String

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId String?

  brand   Brand?  @relation(fields: [brandId], references: [id])
  brandId String?

  images ProductImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
  @@index([divisionId])
  @@index([categoryId])
  @@index([brandId])
  @@index([featured])
  @@index([isActive])
}

model ProductImage {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  url       String
  alt       String
  position  Int     @default(0)

  @@map("product_images")
  @@index([productId, position])
}

// Submissions from the contact form / "Request a Quote" CTAs on product pages
model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  company   String?
  message   String        @db.Text
  productId String? // set if they inquired from a specific product page
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@map("inquiries")
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}
