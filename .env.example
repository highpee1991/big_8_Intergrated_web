# V1 has no live integrations , this file documents what future phases will need.
# Copy to .env.local and fill in when a phase actually requires it.

# --- Phase: Auth (Supabase Auth) ---
# Get these at Project Settings -> API in your Supabase dashboard.
# NEXT_PUBLIC_SUPABASE_URL=
# The key may be labeled "anon / public" or "publishable" depending on
# when your project was created , either works here.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Phase: Imagery (Cloudinary) ---
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# --- Phase: Payments ---
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
